NODE_ENV=production
PORT=5000
# Supabase PostgreSQL connection string (use pgBouncer endpoint)
DATABASE_URL=postgresql://user:password@region.pooler.supabase.com:5432/postgres?schema=public
# JWT secrets - generate strong random values
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Frontend URL (Netlify/Vercel deployed app)
FRONTEND_URL=https://your-frontend.netlify.app
# Stripe keys (if using payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
