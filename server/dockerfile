# Build server
FROM node:18 AS build-server
WORKDIR /app
# Copy root package.json for workspaces
COPY package*.json ./
# Copy shared workspace
COPY shared/package*.json ./shared/
COPY shared/tsconfig.json ./shared/
COPY shared/src ./shared/src
# Copy server files
COPY server/package*.json ./server/
COPY server/tsconfig.json ./server/
COPY server/src ./server/src
COPY server/prisma ./server/prisma
# Install all dependencies (including workspace links)
RUN npm install
# Build server
WORKDIR /app/server
RUN npm run build

# Build client  
FROM node:18 AS build-client
WORKDIR /app/client
COPY client/package*.json ./
RUN npm install
COPY client ./
RUN npm run build

# Runner
FROM node:18 AS runner
WORKDIR /app

# Copy server source and configs
COPY server/package*.json ./server/
COPY server/prisma ./server/prisma

# Copy built artifacts
COPY --from=build-server /app/server/dist ./server/dist
COPY --from=build-client /app/client/dist ./client/dist

# Install production dependencies and generate Prisma
WORKDIR /app/server
RUN npm install --production
RUN npx prisma generate

EXPOSE 5000
CMD ["node", "dist/index.js"]